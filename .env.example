# Contact form mail (lib/mail.ts)
SMTP_USER=automations@davnoot.com
SMTP_PASS=

# Admin panel (/admin): shared password (12+ characters, 16+ recommended) and the cookie-signing secret (32+ characters)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob: added automatically when a Blob store is connected to the Vercel project.
# Locally the admin writes to .cms-data/ instead, even if this is set.
# BLOB_READ_WRITE_TOKEN=

# Optional switches
# CMS_STORE=blob                   use Blob locally (reads)
# CMS_ALLOW_WRITES=1               allow writes to Blob outside production (point it at a test store!)
# CMS_ALLOW_DEFAULTS_ON_ERROR=1    render the code defaults if the Blob store can't be read
